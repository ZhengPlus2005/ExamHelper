<Window x:Class="ExamHelper.InteractionLab.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:beh="clr-namespace:ExamHelper.App.Controls;assembly=ExamHelper.App" Title="ExamHelper Interaction Lab" Width="640" Height="720" MinWidth="480" MinHeight="360" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Focusable" Value="False"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,6"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="#FFDFE7F2" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter HorizontalAlignment="Center"/><ProgressBar Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(beh:DwellBehavior.Progress), Mode=OneWay}"/></Grid></Border></ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border Background="#D9222938" CornerRadius="12" BorderBrush="#68748B" BorderThickness="1" Padding="14">
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="28"/></Grid.RowDefinitions>
      <Border x:Name="MoveHandle" Background="#FF344154" CornerRadius="6"><StackPanel Margin="10,5"><TextBlock Text="ExamHelper · 核心交互验证" Foreground="White" FontSize="18"/><TextBlock Text="悬停标题一秒移动，停稳一秒固定" Foreground="#BDD1EB" FontSize="11"/></StackPanel></Border>
      <WrapPanel Grid.Row="1" Margin="0,8">
        <Button x:Name="CountButton" Content="一秒触发测试"/><Button x:Name="LayoutButton" Content="缩略图移位测试"/>
        <Button x:Name="FoldButton" Content="折叠／展开"/><Button x:Name="HideButton" Content="隐藏（F9 恢复）"/>
        <Button x:Name="CloseButton" Content="退出（两秒）" beh:DwellBehavior.Delay="2"/>
      </WrapPanel>
      <ScrollViewer x:Name="AnswerScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" Background="#33101420" Padding="10" Margin="0,0,0,8"><TextBlock x:Name="AnswerText" Foreground="White" FontSize="15" TextWrapping="Wrap"/></ScrollViewer>
      <StackPanel x:Name="EditPanel" Grid.Row="3">
        <TextBlock Text="悬停输入框一秒获得焦点；仅英文键入。下方文字用于模拟语音。" Foreground="#C3D1E5" TextWrapping="Wrap" FontSize="11"/>
        <TextBox x:Name="Editor" Height="76" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,6"/>
        <WrapPanel><Button x:Name="InsertChinese" Content="模拟语音追加中文"/><Button x:Name="CancelButton" Content="取消输入"/><Button x:Name="ClearButton" Content="清空输入"/></WrapPanel>
      </StackPanel>
      <StackPanel Grid.Row="4"><TextBlock x:Name="ProtectionStatus" Foreground="#A7F3D0" FontSize="11" TextWrapping="Wrap"/><TextBlock x:Name="Status" Foreground="#D5E4FA" FontSize="11" TextWrapping="Wrap"/></StackPanel>
      <Border x:Name="ResizeHandle" Grid.Row="5" Width="24" Height="24" Background="#FF526581" HorizontalAlignment="Right"><TextBlock Text="◢" Foreground="White" HorizontalAlignment="Center"/></Border>
    </Grid>
  </Border>
</Window>
