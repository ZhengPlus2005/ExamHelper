<UserControl x:Class="ExamHelper.App.Controls.ThumbnailStrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:beh="clr-namespace:ExamHelper.App.Controls" Focusable="False">
 <ScrollViewer x:Name="Scroller" MaxHeight="90" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
  <ItemsControl x:Name="Items"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border x:Name="ThumbnailFrame" Background="#702F4055" BorderBrush="#738AA7" BorderThickness="1" CornerRadius="5" Margin="0,0,6,5" Width="112" Height="78" beh:DwellBehavior.Delay="1" beh:DwellBehavior.Command="{Binding DeleteCommand}">
     <Grid><Image Source="{Binding Preview}" Stretch="Uniform" Margin="2"/>
      <Border x:Name="DeletionShade" Background="#B06A6A6A" Visibility="Collapsed" CornerRadius="4"/>
      <Grid x:Name="DeletionMark" Visibility="Collapsed" Width="40" Height="40" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
       <Ellipse Width="30" Height="30" Fill="White"/><TextBlock Text="×" Foreground="#FF4A4A4A" FontSize="23" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-2,0,0"/>
       <beh:HoverDeleteRing Progress="{Binding RelativeSource={RelativeSource AncestorType=Border},Path=(beh:DwellBehavior.Progress),Mode=OneWay}"/>
      </Grid>
     </Grid>
    </Border>
    <DataTemplate.Triggers><Trigger SourceName="ThumbnailFrame" Property="IsMouseOver" Value="True"><Setter TargetName="DeletionShade" Property="Visibility" Value="Visible"/><Setter TargetName="DeletionMark" Property="Visibility" Value="Visible"/></Trigger></DataTemplate.Triggers>
   </DataTemplate></ItemsControl.ItemTemplate>
  </ItemsControl>
 </ScrollViewer>
</UserControl>
