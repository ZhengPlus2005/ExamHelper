<UserControl x:Class="ExamHelper.App.Controls.DraftImageTile" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" Width="144" Height="90">
 <Grid>
  <Button x:Name="PreviewButton" Command="{Binding PreviewCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" Padding="0" Margin="0" BorderThickness="0" Background="Transparent" ToolTip="查看原图">
   <Image Width="144" Height="90" Stretch="UniformToFill" Source="{Binding PreviewSource,RelativeSource={RelativeSource AncestorType=UserControl}}"><Image.Clip><RectangleGeometry Rect="0,0,144,90" RadiusX="9" RadiusY="9"/></Image.Clip></Image>
  </Button>
  <Button x:Name="RemoveButton" Command="{Binding RemoveCommand,RelativeSource={RelativeSource AncestorType=UserControl}}" Content="×" FontSize="18" Width="24" Height="24" Padding="0" Margin="4" HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="DarkRed" Background="White" ToolTip="移除此图片" AutomationProperties.Name="移除此图片"><Button.Template><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="#B5C2CF" BorderThickness="1" CornerRadius="12"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Button.Template></Button>
 </Grid>
</UserControl>
