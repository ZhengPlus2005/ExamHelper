<UserControl x:Class="ExamHelper.App.Controls.ModelSelector" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
 <StackPanel>
  <Grid x:Name="OrdinaryControls" Margin="0,6"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="130"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="配置" FontSize="11"/><ComboBox x:Name="Profiles" DisplayMemberPath="Name" SelectionChanged="ProfileChanged" MinHeight="28"/></StackPanel>
   <StackPanel Grid.Column="2"><TextBlock Text="模型" FontSize="11"/><ComboBox x:Name="Models" DisplayMemberPath="Name" SelectionChanged="ModelChanged" MinHeight="28"/></StackPanel>
   <StackPanel Grid.Column="4"><TextBlock Text="思考" FontSize="11"/><ComboBox x:Name="Thinking" SelectionChanged="ThinkingChanged" MinHeight="28"/></StackPanel>
  </Grid>
  <Grid x:Name="HoverRoot" Height="32" Background="Transparent" Visibility="Collapsed" ClipToBounds="False"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Button x:Name="ProfileEntry" Focusable="False" Padding="5,4" Margin="0,2,4,2"><TextBlock x:Name="ProfileLabel" Text="配置" TextTrimming="CharacterEllipsis" FontSize="11"/></Button>
   <Button x:Name="ModelEntry" Grid.Column="1" Focusable="False" Padding="5,4" Margin="0,2,4,2"><TextBlock x:Name="ModelLabel" Text="模型" TextTrimming="CharacterEllipsis" FontSize="11"/></Button>
   <Button x:Name="ThinkingEntry" Grid.Column="2" Focusable="False" Padding="5,4" Margin="0,2,0,2"><TextBlock x:Name="ThinkingLabel" Text="思考" TextTrimming="CharacterEllipsis" FontSize="11"/></Button>
   <Canvas x:Name="MenuCanvas" Grid.ColumnSpan="3" Height="0" VerticalAlignment="Top" Panel.ZIndex="100" ClipToBounds="False">
    <Border x:Name="MenuBorder" Canvas.Top="30" Visibility="Collapsed" Width="240" Background="#FF223047" CornerRadius="6" BorderBrush="#839CBA" BorderThickness="1" Padding="5"><ScrollViewer x:Name="MenuScroll" MaxHeight="160" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><StackPanel x:Name="MenuItems"/></ScrollViewer></Border>
   </Canvas>
  </Grid>
  <TextBlock x:Name="Unavailable" Foreground="#A04420" TextWrapping="Wrap" Visibility="Collapsed" FontSize="11"/>
 </StackPanel>
</UserControl>
