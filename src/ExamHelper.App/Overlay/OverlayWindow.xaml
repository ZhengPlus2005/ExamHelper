<Window x:Class="ExamHelper.App.Overlay.OverlayWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:beh="clr-namespace:ExamHelper.App.Controls" Title="ExamHelper" Width="640" Height="720" MinWidth="480" MinHeight="360" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ShowActivated="False" Focusable="False">
 <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button">
   <Setter Property="Focusable" Value="False"/><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="9,6"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Frame" Background="#FFE0EAF6" CornerRadius="5" Padding="{TemplateBinding Padding}"><Grid><ContentPresenter HorizontalAlignment="Center"/><ProgressBar Height="3" VerticalAlignment="Bottom" Margin="0,0,0,-4" Maximum="1" Value="{Binding RelativeSource={RelativeSource TemplatedParent},Path=(beh:DwellBehavior.Progress),Mode=OneWay}"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border x:Name="Surface" CornerRadius="12" BorderBrush="#657C99" BorderThickness="1" Padding="12">
  <Grid><Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Border x:Name="MoveHandle" Background="#FF344154" CornerRadius="5"><DockPanel Margin="9,5"><TextBlock Text="ExamHelper" Foreground="White" FontWeight="SemiBold" FontSize="16"/><TextBlock Text="悬停操作 · 主页／退出两秒" Foreground="#BED0E9" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/></DockPanel></Border>
   <WrapPanel Grid.Row="1" Margin="0,6">
    <Button x:Name="DirectButton" Content="截图直发"/><Button x:Name="CaptureButton" Content="截图入草稿"/><Button x:Name="RecordButton" Content="{Binding RecordingLabel}"/>
    <Button x:Name="NewButton" Content="新对话"/><Button x:Name="StopButton" Content="停止回答"/><Button x:Name="FoldButton" Content="折叠／展开"/>
    <Button x:Name="HomeButton" Content="返回主页" beh:DwellBehavior.Delay="2"/><Button x:Name="ExitButton" Content="退出" beh:DwellBehavior.Delay="2"/>
   </WrapPanel>
   <Grid x:Name="Body" Grid.Row="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <ScrollViewer x:Name="AnswerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Background="#30101827" Padding="10" Margin="0,0,0,8" Focusable="False">
     <StackPanel>
      <ItemsControl ItemsSource="{Binding Messages}"><ItemsControl.ItemTemplate><DataTemplate><beh:AnswerView Title="{Binding Title}" Text="{Binding Text}" IsFinal="{Binding IsFinal}"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <beh:ThumbnailStrip x:Name="DraftImages" ItemsSource="{Binding Thumbnails}"/>
      <StackPanel><TextBlock Text="语音草稿（只读）" Foreground="#B8CDE8" FontSize="11"/><ScrollViewer x:Name="DraftScroll" MaxHeight="82" MinHeight="35" VerticalScrollBarVisibility="Auto" Background="#30101827" Padding="8" Margin="0,5" Focusable="False"><TextBlock x:Name="DraftPreview" Text="{Binding DraftText}" Foreground="White" TextWrapping="Wrap" Focusable="False"/></ScrollViewer></StackPanel>
     </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="1"><Button x:Name="ClearButton" Content="清空输入"/><Button x:Name="SendButton" Content="发送"/>
     <Button x:Name="UndoButton" Content="撤销本次语音" Visibility="{Binding CanUndo,Converter={StaticResource BoolVisibility}}" MouseEnter="UndoEnter" MouseLeave="UndoLeave"/>
     <Button x:Name="RetrySpeechButton" Content="重试识别" Visibility="{Binding HasSpeechFailure,Converter={StaticResource BoolVisibility}}"/><Button x:Name="DiscardSpeechButton" Content="丢弃录音" Visibility="{Binding HasSpeechFailure,Converter={StaticResource BoolVisibility}}"/>
     <Button x:Name="RetryRequestButton" Content="重试回答" Visibility="{Binding HasRequestFailure,Converter={StaticResource BoolVisibility}}"/><Button x:Name="DiscardRequestButton" Content="丢弃失败请求" Visibility="{Binding HasRequestFailure,Converter={StaticResource BoolVisibility}}"/>
    </WrapPanel>
   </Grid>
   <ScrollViewer x:Name="StatusScroll" Grid.Row="3" MaxHeight="40" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"><TextBlock Text="{Binding Status}" Foreground="#D2E1F5" TextWrapping="Wrap" FontSize="11" Margin="2,5"/></ScrollViewer>
   <Border x:Name="ResizeHandle" Grid.Row="4" Width="24" Height="24" Background="#FF526581" HorizontalAlignment="Right"><TextBlock Text="◢" Foreground="White" HorizontalAlignment="Center"/></Border>
  </Grid>
 </Border>
</Window>