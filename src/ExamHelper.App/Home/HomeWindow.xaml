<Window Icon="/ExamHelper.App;component/Assets/app-icon.ico" x:Class="ExamHelper.App.Home.HomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ExamHelper.App.Controls" Title="ExamHelper" Width="1080" Height="800" MinWidth="820" MinHeight="600" Background="#F3F5F8" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style></Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Left"><TextBlock Text="ExamHelper" FontSize="25" FontWeight="SemiBold"/><TextBlock Text="直接聊天无需服务测试；开始考试须通过图片和语音测试。" Foreground="#526174" FontSize="12" Margin="0,5,0,0"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="设置" Click="SettingsClick"/><Button Content="开始考试" Click="StartClick" Background="#D9EBFF"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel><WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8"><Button Content="新对话" Click="NewClick"/><Button Content="改标题" Click="RenameClick"/><Button Content="删除" Click="DeleteClick"/></WrapPanel>
    <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" SelectionChanged="SelectionChanged" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,9"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdatedAt,StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="#66758A" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   </DockPanel>
   <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" AllowDrop="True" PreviewDragOver="DraftDragOver" Drop="DraftDrop"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding ConversationTitleText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryMessages"/></ScrollViewer>
    <controls:ModelSelector x:Name="HomeModels" Grid.Row="2"/>
    <ScrollViewer Grid.Row="3" MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="HomeDraftPictures"/></ScrollViewer>
    <TextBox x:Name="HomeDraftInput" Grid.Row="4" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="140" Padding="9" FontSize="14" Margin="0,8,0,5" TextChanged="DraftTextChanged"/>
    <StackPanel Grid.Row="5"><WrapPanel><Button Content="发送" Click="SendClick" IsEnabled="{Binding CanSend}" Background="#D9EBFF"/><Button Content="停止回答" Click="StopClick" IsEnabled="{Binding CanStop}"/><Button Content="清空输入" Click="ClearClick"/><Button Content="重试回答" Click="RetryAnswerClick" Visibility="{Binding HasFailedRequest,Converter={StaticResource BoolVisibility}}"/><Button Content="丢弃失败请求" Click="DiscardAnswerClick" Visibility="{Binding HasFailedRequest,Converter={StaticResource BoolVisibility}}"/><Button Content="撤销本次语音" Click="UndoSpeechClick" Visibility="{Binding CanUndoSpeech,Converter={StaticResource BoolVisibility}}"/><Button Content="重试识别" Click="RetrySpeechClick" Visibility="{Binding HasFailedSpeech,Converter={StaticResource BoolVisibility}}"/><Button Content="丢弃录音" Click="DiscardSpeechClick" Visibility="{Binding HasFailedSpeech,Converter={StaticResource BoolVisibility}}"/></WrapPanel><TextBlock Text="Enter 发送 · Shift + Enter 换行 · 支持粘贴和拖入图片" Foreground="#66758A" FontSize="11" Margin="4,5,0,0"/></StackPanel>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#8A3A12" Margin="0,10,0,0"/>
 </Grid>
</Window>
