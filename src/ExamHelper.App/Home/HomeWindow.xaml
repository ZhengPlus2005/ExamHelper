<Window x:Class="ExamHelper.App.Home.HomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="ExamHelper" Width="1000" Height="740" MinWidth="760" MinHeight="560" Background="#F3F5F8" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="ExamHelper" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="历史对话" Foreground="#526174" Margin="0,4,0,14"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="设置" Click="SettingsClick"/><Button Content="开始考试" Click="StartClick" Background="#D9EBFF"/></StackPanel></DockPanel>
    <TextBlock Grid.Row="1" Text="开始考试将新建对话。首次使用请在设置中完成 AI 图片与语音识别测试。" TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,14"/>
    <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="270"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <DockPanel><StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"><Button Content="继续此对话" Click="ContinueClick"/><Button Content="删除" Click="DeleteClick"/></StackPanel>
        <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" SelectionChanged="SelectionChanged" BorderThickness="0" Background="White"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="6,8"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding UpdatedAt,StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" FontSize="11" Foreground="#66758A"/><TextBlock Text="{Binding HasSavedDraft,StringFormat='保留草稿：{0}'}" FontSize="11" Foreground="#66758A"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
      </DockPanel>
      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" Background="White" Padding="18"><StackPanel><TextBox Text="{Binding HistoryText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" FontSize="14"/><StackPanel x:Name="HistoryPictures"/></StackPanel></ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="3" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#8A3A12" Margin="0,14,0,0"/>
  </Grid>
</Window>