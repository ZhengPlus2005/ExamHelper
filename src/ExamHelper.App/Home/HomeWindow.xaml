<Window Icon="/ExamHelper.App;component/Assets/app-icon.ico" x:Class="ExamHelper.App.Home.HomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ExamHelper.App.Controls" Title="ExamHelper" Width="1080" Height="800" MinWidth="820" MinHeight="600" Background="#F3F5F8" WindowStartupLocation="CenterScreen">
 <Window.Resources><BooleanToVisibilityConverter x:Key="BoolVisibility"/><Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style><Style x:Key="HistoryIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1"/><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="Focusable" Value="False"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="#3C5874"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#D9EBFF"/></Trigger></Style.Triggers></Style></Window.Resources>
 <Grid x:Name="MainRoot" Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,14"><StackPanel DockPanel.Dock="Left"><TextBlock Text="ExamHelper" FontSize="25" FontWeight="SemiBold"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="使用说明" Click="UsageClick"/><Button Content="设置" Click="SettingsClick"/><Button Content="开始考试" Click="StartClick" Background="#D9EBFF"/></StackPanel></DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" IsEnabled="{Binding CanEditHistory}">
     <WrapPanel x:Name="OrdinaryHistoryActions"><WrapPanel.Style><Style TargetType="WrapPanel"><Style.Triggers><DataTrigger Binding="{Binding HistorySelection.IsBatchMode}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></WrapPanel.Style><Button Content="新对话" Click="NewClick"/><Button x:Name="BatchEditButton" Content="批量编辑" Click="BeginBatchClick"/></WrapPanel>
     <StackPanel x:Name="BatchHistoryActions" Visibility="{Binding HistorySelection.IsBatchMode,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding HistorySelection.SelectedCount,StringFormat='已选 {0} 条'}" Margin="4,4"/><WrapPanel><Button Content="全选" Click="SelectAllHistoryClick"/><Button Content="取消全选" Click="ClearHistorySelectionClick"/><Button Content="删除所选" Click="DeleteSelectedClick" IsEnabled="{Binding CanDeleteSelected}"/><Button Content="完成" Click="FinishBatchClick"/></WrapPanel></StackPanel>
     <Button Content="重试图片清理" Click="RetryImageCleanupClick" Visibility="{Binding HasImageCleanupFailure,Converter={StaticResource BoolVisibility}}"/>
    </StackPanel>
    <ListBox x:Name="HistoryList" ItemsSource="{Binding History}" SelectionChanged="SelectionChanged" PreviewMouseLeftButtonDown="HistoryRowClick" IsEnabled="{Binding CanEditHistory}" BorderThickness="0" Background="White" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
     <ListBox.ItemTemplate><DataTemplate>
      <Grid x:Name="HistoryRow" Background="Transparent" Margin="4,9"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <CheckBox x:Name="HistoryCheck" IsChecked="{Binding IsChecked,Mode=TwoWay}" Focusable="False" Click="HistoryCheckClick" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="{Binding DataContext.HistorySelection.IsBatchMode,RelativeSource={RelativeSource AncestorType=ListBox},Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="选择此对话"/>
       <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" TextWrapping="Wrap" FontWeight="SemiBold"/><TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="#66758A" Margin="0,5,0,0"/></StackPanel>
       <StackPanel x:Name="RowActions" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Visibility="Hidden"><Button x:Name="RenameHistoryIcon" Click="RenameHistoryRowClick" Style="{StaticResource HistoryIconButton}" ToolTip="重命名" AutomationProperties.Name="重命名"><TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"/></Button><Button x:Name="DeleteHistoryIcon" Click="DeleteHistoryRowClick" Style="{StaticResource HistoryIconButton}" ToolTip="删除" AutomationProperties.Name="删除"><TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"/></Button></StackPanel>
      </Grid>
      <DataTemplate.Triggers>
       <MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"/><Condition Binding="{Binding DataContext.HistorySelection.IsBatchMode,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="False"/></MultiDataTrigger.Conditions><Setter TargetName="RowActions" Property="Visibility" Value="Visible"/></MultiDataTrigger>
       <DataTrigger Binding="{Binding DataContext.HistorySelection.IsBatchMode,RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True"><Setter TargetName="RowActions" Property="Visibility" Value="Collapsed"/></DataTrigger>
      </DataTemplate.Triggers>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </DockPanel>
   <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="16" AllowDrop="True" PreviewDragOver="DraftDragOver" Drop="DraftDrop"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="{Binding ConversationTitleText}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,10"/>
    <ScrollViewer x:Name="HistoryScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="HistoryMessages"/></ScrollViewer>
    <controls:ModelSelector x:Name="HomeModels" Grid.Row="2"/>
    <ScrollViewer Grid.Row="3" MaxHeight="112" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="HomeDraftPictures" IsEnabled="{Binding CanEditDraft}"/></ScrollViewer>
    <TextBox x:Name="HomeDraftInput" Grid.Row="4" IsEnabled="{Binding CanEditDraft}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MinHeight="80" MaxHeight="140" Padding="9" FontSize="14" Margin="0,8,0,5" TextChanged="DraftTextChanged"/>
    <DockPanel Grid.Row="5"><Button x:Name="ExportButton" DockPanel.Dock="Right" Content="导出" Click="ExportClick" VerticalAlignment="Top"/><WrapPanel><Button Content="发送" Click="SendClick" IsEnabled="{Binding CanSend}" Background="#D9EBFF"/><Button Content="停止回答" Click="StopClick" IsEnabled="{Binding CanStop}"/><Button Content="重试回答" Click="RetryAnswerClick" Visibility="{Binding HasFailedRequest,Converter={StaticResource BoolVisibility}}"/><Button Content="丢弃失败请求" Click="DiscardAnswerClick" Visibility="{Binding HasFailedRequest,Converter={StaticResource BoolVisibility}}"/><Button Content="撤销本次语音" Click="UndoSpeechClick" Visibility="{Binding CanUndoSpeech,Converter={StaticResource BoolVisibility}}"/><Button Content="重试识别" Click="RetrySpeechClick" Visibility="{Binding HasFailedSpeech,Converter={StaticResource BoolVisibility}}"/><Button Content="丢弃录音" Click="DiscardSpeechClick" Visibility="{Binding HasFailedSpeech,Converter={StaticResource BoolVisibility}}"/></WrapPanel></DockPanel>
   </Grid></Border>
  </Grid>
  <TextBlock Grid.Row="2" Text="{Binding Status}" TextWrapping="Wrap" Foreground="#8A3A12" Margin="0,10,0,0"/>
 </Grid>
</Window>
