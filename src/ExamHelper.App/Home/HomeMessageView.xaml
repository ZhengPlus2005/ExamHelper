<UserControl x:Class="ExamHelper.App.Home.HomeMessageView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False">
 <StackPanel>
  <DockPanel Margin="0,0,0,7">
   <Button x:Name="CopyMessageButton" DockPanel.Dock="Right" FontFamily="Segoe MDL2 Assets" Content="&#xE8C8;" Padding="4" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" ToolTip="复制文字" AutomationProperties.Name="复制此消息文字"/>
   <TextBlock x:Name="TimingLabel" DockPanel.Dock="Right" Foreground="#66758A" VerticalAlignment="Center" Margin="8,0,4,0"/>
   <TextBlock x:Name="Header" FontWeight="SemiBold" Foreground="#435974" VerticalAlignment="Center"/>
  </DockPanel>
  <WrapPanel x:Name="Pictures"/>
  <ContentControl x:Name="Body" Focusable="False"/>
 </StackPanel>
</UserControl>
