<Window Icon="/ExamHelper.App;component/Assets/app-icon.ico" x:Class="ExamHelper.App.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:ExamHelper.App.Controls" Title="设置 · ExamHelper" Width="790" Height="780" MinWidth="620" MinHeight="560" Background="#F3F5F8" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="PasswordBox"><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,4,0,12"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,7"/><Setter Property="Margin" Value="3"/></Style>
 </Window.Resources>
 <Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="{Binding VerificationSummary}" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <TabControl x:Name="SettingsTabs" Grid.Row="1">
   <TabItem Header="AI 服务"><Grid Margin="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <WrapPanel Margin="0,0,0,12"><Button Content="＋ 添加配置" Click="AddProfileClick"/><Button Content="启用选中配置" Click="ActivateProfileClick" IsEnabled="{Binding HasSelectedAiProfile}"/><Button Content="删除" Click="DeleteProfileClick" IsEnabled="{Binding HasSelectedAiProfile}"/></WrapPanel>
    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <ListBox x:Name="ProfilesList" ItemsSource="{Binding AiProfiles}" SelectedItem="{Binding SelectedAiProfile,Mode=TwoWay}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
      <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="5,9"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Status}" Foreground="#4A6B5A" FontSize="11" Margin="0,5,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
     <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"><StackPanel IsEnabled="{Binding HasSelectedAiProfile}">
      <TextBlock Text="配置名称"/><TextBox Text="{Binding SelectedAiProfile.Name,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="API 地址"/><TextBox Text="{Binding AiBaseAddress,UpdateSourceTrigger=PropertyChanged}"/>
      <WrapPanel><Button Content="拉取模型" Click="FetchModelsClick"/><Button Content="加入勾选模型" Click="AddDiscoveredModelsClick"/></WrapPanel>
<ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding SelectedAiProfile.DiscoveredModels}"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" Margin="4"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<TextBlock Text="模型（每项独立测试）"/>
<ComboBox ItemsSource="{Binding SelectedAiProfile.Models}" SelectedItem="{Binding SelectedAiProfile.SelectedModel}" DisplayMemberPath="Name" Margin="0,4,0,8"/>
<WrapPanel><Button Content="添加模型" Click="AddModelClick"/><Button Content="删除模型" Click="DeleteModelClick"/><Button Content="设为默认" Click="DefaultModelClick"/></WrapPanel>
<TextBlock Text="真实模型 ID"/><TextBox Text="{Binding SelectedAiProfile.SelectedModel.Name,UpdateSourceTrigger=PropertyChanged}"/>
<TextBlock Text="默认模型"/><ComboBox ItemsSource="{Binding SelectedAiProfile.Models}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedAiProfile.DefaultModelId}" Margin="0,4,0,12"/>
<TextBlock Text="默认思考设置"/><ComboBox ItemsSource="{Binding SelectedAiProfile.SelectedModel.ThinkingOptions}" SelectedItem="{Binding SelectedAiProfile.SelectedModel.DefaultThinking}" Margin="0,4,0,12"/>
<CheckBox Content="手动指定思考能力（仅在了解接口协议时填写）" IsChecked="{Binding SelectedAiProfile.SelectedModel.ManualCapability}"/>
<TextBlock Text="支持类型"/><ComboBox ItemsSource="{Binding ThinkingControls}" SelectedItem="{Binding SelectedAiProfile.SelectedModel.Control}"/>
<TextBlock Text="请求方式"/><ComboBox ItemsSource="{Binding ThinkingFormats}" SelectedItem="{Binding SelectedAiProfile.SelectedModel.WireFormat}"/>
<TextBlock Text="合法强度（逗号分隔，如 low,high,max）"/><TextBox Text="{Binding SelectedAiProfile.SelectedModel.Levels,UpdateSourceTrigger=PropertyChanged}"/>
      <TextBlock Text="API 密钥（仅为当前 Windows 用户加密保存）"/><PasswordBox x:Name="AiKey" PasswordChanged="AiPasswordChanged"/>
      <WrapPanel><Button Content="文字测试" Click="TextTestClick"/><Button Content="图片测试" Click="ImageTestClick"/></WrapPanel>
      <TextBlock Text="测试仅针对选中项，不会自动启用。每项图片资格独立保存；新增、编辑、启用或删除后请保存并返回。" TextWrapping="Wrap" Foreground="#526174" Margin="0,12"/>
     </StackPanel></ScrollViewer>
    </Grid>
   </Grid></TabItem>
   <TabItem Header="语音识别"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="阿里云北京 API 地址"/><TextBox Text="{Binding AsrBaseAddress,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="模型名称"/><TextBox Text="{Binding AsrModel,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="语音服务密钥"/><PasswordBox x:Name="AsrKey" PasswordChanged="AsrPasswordChanged"/>
    <TextBlock Text="麦克风"/><ComboBox ItemsSource="{Binding Devices}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding DeviceId}" Margin="0,4,0,12"/>
    <TextBlock Text="只采集麦克风。请说一句中文夹杂英文的话，停录后核对识别结果。" TextWrapping="Wrap" Margin="0,4,0,12"/>
    <TextBlock Text="{Binding MicrophoneLevel,StringFormat=麦克风音量：{0:P0}}" Foreground="#526174" Margin="0,0,0,6"/><ProgressBar x:Name="MicrophoneMeter" Value="{Binding MicrophoneLevel,Mode=OneWay}" Minimum="0" Maximum="1" Foreground="#33A774" Background="#DFE5EC" Height="12"/><TextBlock Text="{Binding RecordingSeconds,StringFormat='录音时长：{0:F1} 秒'}" Margin="0,8"/>
    <WrapPanel><Button Content="开始／停止测试录音" Click="SpeechTestClick"/><Button Content="识别正确" Click="ConfirmSpeechClick" IsEnabled="{Binding CanConfirmSpeech}"/></WrapPanel>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="回答与外观"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="默认编程语言"/><TextBox Text="{Binding DefaultCodeLanguage,UpdateSourceTrigger=PropertyChanged}"/>
    <TextBlock Text="截图直发预置提示词（自动保存，仅直发附加）"/><TextBox x:Name="PresetPrompt" Text="{Binding DirectCapturePrompt,UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" TextChanged="PromptChanged"/>
    <TextBlock Text="辅助窗口背景不透明度（35%～100%）"/>
    <Grid Margin="0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions><Slider Minimum="0.35" Maximum="1" Value="{Binding Opacity,UpdateSourceTrigger=PropertyChanged}" TickFrequency="0.05" VerticalAlignment="Center"/><TextBlock x:Name="OpacityPercentage" Grid.Column="1" Text="{Binding OpacityPercent}" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <TextBlock Text="下方为效果演示：本软件覆盖在答题窗口上，背景跟随滑块变化。" TextWrapping="Wrap" Foreground="#526174" Margin="0,0,0,10"/>
    <controls:OpacityPreview x:Name="OpacityDemo" BackgroundOpacity="{Binding Opacity}"/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="快捷键"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="18">
    <TextBlock Text="例如 Ctrl+Alt+F1，留空不绑定。保存时检查修改后的组合冲突；Esc 保留给移动／缩放／滚动。" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <ItemsControl ItemsSource="{Binding Hotkeys}"><ItemsControl.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Name}" VerticalAlignment="Center"/><TextBox Grid.Column="1" Text="{Binding Text,UpdateSourceTrigger=PropertyChanged}"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   </StackPanel></ScrollViewer></TabItem>
  </TabControl>
  <StackPanel Grid.Row="2" Margin="0,12"><TextBlock Text="{Binding Status}" Foreground="#8A3A12" TextWrapping="Wrap"/><TextBox Text="{Binding ResultText,Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="130" VerticalScrollBarVisibility="Auto"/></StackPanel>
  <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="关闭" Click="CloseClick"/><Button Content="保存并返回" Click="SaveClick" Background="#D9EBFF"/></StackPanel>
 </Grid>
</Window>
